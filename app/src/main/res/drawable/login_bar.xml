<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Set a semi-transparent white background -->
    <solid android:color="#1AEAE9F0" /> <!-- 10% opacity of #EAE9F0 -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" /> <!-- Reduced radius for subtler rounding -->

    <!-- Padding inside the shape -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

    <!-- Border with light color -->
    <stroke
        android:width="1dp"
        android:color="#EAE9F0" /> <!-- Border matches the light background -->
</shape>
