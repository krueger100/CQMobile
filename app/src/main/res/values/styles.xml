<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">#1C2244</item>
        <item name="colorAccent">#7D7D7D</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <!-- Full-Screen Theme for Splash Screen -->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/darkBlue</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:navigationBarColor">#2D3666</item>
    </style>

    <!-- Base application theme -->
    <style name="RemoveTitle" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ClockStyle" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/darkBlue</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:navigationBarColor">#2D3666</item>
    </style>

</resources>